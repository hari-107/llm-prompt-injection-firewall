# ---------------------------------------------------------------------------
# LLM Prompt Injection Firewall — environment configuration
# Copy to .env and adjust. All values have safe defaults for local dev.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database. If DB_ENGINE is sqlite (default) the DB_* Postgres vars are ignored.
DB_ENGINE=sqlite
DB_NAME=firewall
DB_USER=firewall
DB_PASSWORD=firewall
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (caching + rate limiting). If unset, an in-memory cache is used.
REDIS_URL=

# ---- Firewall policy ------------------------------------------------------
# Global action floor per risk level is driven by thresholds below.
FIREWALL_USE_AI=true
FIREWALL_OUTPUT_BLOCK_THRESHOLD=0.7

# Risk thresholds (score in [0,1] at or above which a level is assigned).
RISK_THRESHOLD_LOW=0.20
RISK_THRESHOLD_MEDIUM=0.45
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_CRITICAL=0.90

# ---- Rate limiting --------------------------------------------------------
RATELIMIT_REQUESTS=60
RATELIMIT_WINDOW_SECONDS=60
RATELIMIT_BLOCK_AFTER_ATTACKS=5
RATELIMIT_BLOCK_COOLDOWN_SECONDS=900

# ---- Secondary classifier model (optional) --------------------------------
# If unset, the firewall uses the built-in heuristic classifier so it runs
# fully offline. Set provider + key to enable the LLM-backed classifier.
CLASSIFIER_PROVIDER=            # openai | anthropic | (empty = heuristic)
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=gpt-4o-mini
CLASSIFIER_BASE_URL=

# ---- Upstream LLM (the model the firewall protects) -----------------------
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=

# Local Ollama chatbot
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT_SECONDS=120

# Optional separate local Ollama model/server for terms-to-rules extraction.
# Leave blank to use OLLAMA_MODEL / OLLAMA_BASE_URL above.
POLICY_OLLAMA_MODEL=
POLICY_OLLAMA_BASE_URL=

# Optional external AI correction (never the main chatbot)
ENABLE_AI_CORRECTION=false
CORRECTION_API_KEY=
CORRECTION_BASE_URL=
CORRECTION_MODEL=
CORRECTION_TIMEOUT_SECONDS=30
CORRECTION_MAX_TOKENS=1000
